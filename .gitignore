# ---------------------------------------------------------------- Python
.venv/
.venvlib/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------- 本地数据
# 数据库、上传的简历、导出件、浏览器登录态、日志——全部是个人数据，绝不入库
data/*
!data/.gitkeep

# ---------------------------------------------------------------- 模型权重
# bge-small-zh-v1.5 + bge-reranker-v2-m3 约 2.3GB，首次使用时自动下载
models/

# ---------------------------------------------------------------- 密钥
.env
.env.local
data/secrets.json

# ---------------------------------------------------------------- 个人素材
# 简历 PDF / 预览截图不进仓库；docs/images 里的文档配图要保留
samples/*.pdf
samples/*.png
samples/*.html
*.pdf

# ---------------------------------------------------------------- 杂项
.tmp*/
.pipcache/
pip-*

# 本地静态检查工具（ruff 等）
.devtools/
